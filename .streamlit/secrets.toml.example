# Copy this file to .streamlit/secrets.toml for LOCAL development and fill
# in a real key. Never commit the real secrets.toml to git — it's already
# excluded in .gitignore.
#
# For Streamlit Community Cloud, don't upload a secrets.toml at all: paste
# this same content into your app's Settings -> Secrets in the dashboard
# instead. That's the only place the real key should live.

GOOGLE_API_KEY = "paste-your-real-gemini-api-key-here"
